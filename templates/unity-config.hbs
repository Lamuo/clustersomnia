<div class="sotdl-unity-config">
  <ul class="sotdl-unity-config-list">
    {{#each pairs as |pair|}}
    <li class="sotdl-unity-config-row">
      <span class="sotdl-unity-config-names">{{pair.a}} + {{pair.b}}</span>
      <input type="number" min="1" step="1" value="{{pair.cost}}" data-pair="{{pair.key}}">
    </li>
    {{else}}
    <li>Nessun PG del party trovato (personaggi con un giocatore proprietario e il talento "Punti Unione").</li>
    {{/each}}
  </ul>
  <footer class="sotdl-unity-config-footer">
    <button type="button" data-action="save">Salva</button>
    <button type="button" data-action="resetUsed">Azzera mosse usate</button>
    <button type="button" data-action="cancel">Annulla</button>
  </footer>
</div>
