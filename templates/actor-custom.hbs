<div class="clustersomnia-custom" data-tab="custom" hidden>
  <section>
    <div class="sotdl-section-header">{{localize "CLUSTERSOMNIA.SpecsHeader"}}</div>
    <div class="cc-specs">
      {{#each specializations as |spec|}}
      <button type="button" class="cc-spec{{#if spec.on}} on{{/if}}" style="--spec-color: {{spec.css}}" data-action="toggleSpec" data-id="{{spec.id}}" title="{{spec.title}}">
        <i class="{{spec.icon}}"></i><span>{{spec.short}}</span>
      </button>
      {{/each}}
    </div>
    {{#if isGM}}
    <details class="cc-library">
      <summary>{{localize "CLUSTERSOMNIA.Library"}}</summary>
      <ul>
        {{#each library as |spec|}}
        <li>
          <i class="{{spec.icon}}" style="color: {{spec.css}}"></i>
          <span class="cc-library-name" title="{{spec.effect}}">{{spec.name}}</span>
          <button type="button" data-action="libraryEdit" data-id="{{spec.id}}" title="{{localize "CLUSTERSOMNIA.Edit"}}"><i class="fas fa-pen"></i></button>
          <button type="button" data-action="libraryRemove" data-id="{{spec.id}}" title="{{localize "CLUSTERSOMNIA.Delete"}}"><i class="fas fa-trash"></i></button>
        </li>
        {{/each}}
      </ul>
      <button type="button" data-action="libraryAdd"><i class="fas fa-plus"></i> {{localize "CLUSTERSOMNIA.NewSpec"}}</button>
    </details>
    {{/if}}
  </section>

  <section>
    <div class="sotdl-section-header">{{localize "CLUSTERSOMNIA.SignatureHeader"}}</div>
    <div class="cc-signature">
      <input type="text" data-signature-field="name" value="{{signature.name}}" placeholder="{{localize "CLUSTERSOMNIA.SignatureName"}}">
      <input type="text" data-signature-field="icon" value="{{signature.icon}}" placeholder="{{localize "CLUSTERSOMNIA.SignatureIcon"}}">
      <div class="cc-signature-image">
        <button type="button" data-action="signatureImage" title="{{localize "CLUSTERSOMNIA.SignatureImageHint"}}">
          {{#if signature.image}}<img src="{{signature.image}}">{{else}}<i class="fas fa-image"></i>{{/if}} {{localize "CLUSTERSOMNIA.SignatureImage"}}
        </button>
        <button type="button" data-action="signatureClear" title="{{localize "CLUSTERSOMNIA.SignatureClear"}}"><i class="fas fa-trash"></i></button>
      </div>
    </div>
  </section>

  {{#unless showTags}}
  {{! With the Tracker's own Tag section on (setting), the buttons are there; never twice. }}
  <section>
    <div class="sotdl-section-header">{{localize "CLUSTERSOMNIA.TagsHeaderManual"}}</div>
    <div class="sotdl-tag-buttons">
      {{#each tags as |tag|}}
      <button type="button" class="sotdl-tag-button{{#if tag.up}} up{{/if}}{{#if tag.down}} down{{/if}} tier-{{tag.tier}}" data-action="tagCycle" data-tag-id="{{tag.id}}" title="{{tag.name}}">
        {{tag.label}}{{#if tag.glyphs}} {{tag.glyphs}}{{/if}}
      </button>
      {{/each}}
    </div>
  </section>
  {{/unless}}
</div>
